{
  "name": "parity-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Check that every copy of a fact still matches its source of truth, and that a review date was earned by an actual recheck. Compares a canonical record set to its mirrors, finds hand-typed copies of registered constants in text, and audits review stamps between two snapshots. Zero-dependency, framework-agnostic TypeScript.",
  "keywords": [
    "data-parity",
    "mirror",
    "drift",
    "review-date",
    "single-source-of-truth",
    "data-quality",
    "honesty",
    "ci",
    "honesty-kits"
  ],
  "author": "Lucas Kopietz",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
