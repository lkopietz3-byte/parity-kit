{
  "name": "parity-kit",
  "version": "0.1.0",
  "description": "Check that copies of a fact still match their source of truth, and catch review dates that moved with nothing in the data to show a recheck.",
  "keywords": [
    "data-parity",
    "mirror",
    "drift",
    "review-date",
    "single-source-of-truth",
    "data-quality",
    "honesty",
    "ci",
    "honesty-kits",
    "mirror-check",
    "stale-data",
    "dataset-diff",
    "typescript",
    "zero-dependency"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/parity-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/parity-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/parity-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "METHOD.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "node scripts/prepare.mjs",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "bench": "npm run build && node bench/run.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "deep-diff": "1.0.2",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "microdiff": "1.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
